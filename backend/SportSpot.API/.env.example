# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO SPORTSPOT API
# ==========================================

# 1. Chuỗi kết nối PostgreSQL (Supabase / Neon / Local PostgreSQL)
# Format Supabase Transaction Pooler (Port 6543) hoặc Direct Connection (Port 5432):
DATABASE_CONNECTION_STRING=Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.your-project-id;Password=your-strong-password;

# 2. Cấu hình JWT Token
JWT_SECRET_KEY=SportSpot_PRM393_Secret_Key_Super_Secure_2026_Key_Must_Be_Long_Enough!
JWT_ISSUER=SportSpotAPI
JWT_AUDIENCE=SportSpotMobileApp
JWT_EXPIRY_DAYS=30
