# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU CHO SPORTSPOT (.env.example)
# Sao chép file này thành .env trong backend/SportSpot.API/.env
# ==========================================

# Chuỗi kết nối Supabase PostgreSQL Cloud:
# LƯU Ý QUAN TRỌNG: Tại Việt Nam, nên dùng Session Pooler IPv4 (Port 5432) để tránh lỗi TimeoutException 15s do mạng không route được IPv6:
# Format chuẩn Session Pooler IPv4:
DATABASE_CONNECTION_STRING=Host=aws-0-ap-south-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.nolcuulfbugjnrhmivsn;Password=SportSpot2026@;SSL Mode=Require;Trust Server Certificate=true;

# Cấu hình JWT
JWT_SECRET_KEY=SportSpot_PRM393_Secret_Key_Super_Secure_2026_Key_Must_Be_Long_Enough!
JWT_ISSUER=SportSpotAPI
JWT_AUDIENCE=SportSpotMobileApp
JWT_EXPIRY_DAYS=30

# Cấu hình gửi Email OTP qua Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=SportSpot Vietnam

# ==========================================
# CẤU HÌNH CỔNG THANH TOÁN VIETQR PAYOS
# ==========================================
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key

# ==========================================
# CẤU HÌNH NGROK TUNNEL (DOCKER / LOCAL)
# ==========================================
# Lấy authtoken tại: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your-ngrok-authtoken
# Domain cố định miễn phí (nếu có, e.g. your-name.ngrok-free.app): https://dashboard.ngrok.com/cloud-edge/domains
NGROK_DOMAIN=your-domain.ngrok-free.dev

# Ảnh hồ sơ sân: backend upload qua Cloudinary unsigned preset.
# Không cần đưa API secret vào ứng dụng Flutter.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
